{
  "skill": "work-time-tracking",
  "version": "3.6",
  "log_directory": "",
  "timezone": "+08:00",
  "tracking": {
    "enabled": true,
    "auto_tracking": true,
    "idle_threshold_minutes": 30
  },
  "host_events": {
    "enabled": true,
    "capture_user_interaction": true,
    "capture_tool_activity": true,
    "capture_file_activity": true,
    "capture_session_lifecycle": true
  },
  "ai": {
    "enabled": true,
    "model_aliases": {},
    "record_summarize_threshold_chars": 120,
    "auto_analysis": {
      "enabled": true,
      "batch_interval_minutes": 20,
      "cooldown_minutes": 10,
      "safety_max_calls_per_day": 50,
      "max_context_items": 20,
      "enable_cache": true,
      "batch_max_pending": 5
    },
    "manual": {
      "enabled": true,
      "unlimited": true
    }
  },
  "summary": {
    "enabled": true,
    "auto_scheduled": true,
    "stale_conversation_threshold": 3,
    "insights": {
      "enabled": true,
      "stale_days": 30,
      "top_n": 5,
      "skill_roots": []
    }
  },
  "sync": {
    "enabled": true,
    "skill": "ticktick-work-review",
    "realtime": false,
    "auto_scheduled": true
  },
  "log": {
    "keep_days": 1,
    "protect_unsynced": true
  },
  "settlement": {
    "enabled": true,
    "auto_on_conversation_end": true,
    "skill_token_method": "injection",
    "token_per_char": 0.28,
    "score_enabled": true,
    "write_raw_snapshot": true,
    "capture_work_activities": "off",
    "retain_days": 0
  },
  "storage": {
    "structured_log_retention": "permanent",
    "raw_log": {
      "enabled": true,
      "retention_days": 7
    },
    "daily_summary": {
      "retention": "permanent"
    }
  },
  "github": {
    "enabled": false,
    "repository": "worktimeLog",
    "visibility": "private",
    "sync_days": 1,
    "sync_raw_logs": false,
    "work_directory": "",
    "remote": "origin",
    "branch": "main",
    "commit_message": "chore(logs): sync {date}"
  },
  "daily_summary": {
    "enabled": true
  },
  "ticktick": {
    "enabled": true
  },
  "project_map": {},
